<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NCode.PropertyBag</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Description>The interfaces and strongly typed keys of NCode.PropertyBag: IPropertyBag, IReadOnlyPropertyBag, IPropertyBagScope and PropertyBagKey, for libraries that accept or read a property bag without depending on its implementation.</Description>
    <PackageTags>property-bag typed-dictionary key-value strongly-typed type-safe context abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
  </ItemGroup>
</Project>
